{
  "name": "treasury-liquidity",
  "version": "1.0.0",
  "private": true,
  "description": "Treasury yield curve viewer and liquidity order desk",
  "workspaces": ["server", "web"],
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "seed": "npx tsx server/scripts/seed.ts",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
